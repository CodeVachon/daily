# Shared env schema for the whole monorepo (https://varlock.dev).
# This file is committed. Put real values in `.env.local` (gitignored) at the repo root.
# Apps and packages pull what they need via `@import(../../)` in their own .env.schema.
#
# @defaultSensitive=false
# @defaultRequired=infer
# Resolve every value when the server boots, never inline at build time, so one
# Docker image runs anywhere with its env file (see Dockerfile).
# @defaultDynamic=true
# @currentEnv=$APP_ENV
# ---

# Which environment we are running in. Selects `.env.<APP_ENV>` overrides.
# @type=enum(development, test, production)
APP_ENV=development

# --- Database ---------------------------------------------------------------

# Postgres connection string. Defaults to the docker-compose database.
# @type=url(allowedProtocols=[postgres, postgresql]) @sensitive
DATABASE_URL=postgres://postgres:postgres@localhost:5432/daily

# --- Better Auth ------------------------------------------------------------

# Secret used to sign sessions/cookies. Generate with `openssl rand -base64 32`.
# @required @sensitive
BETTER_AUTH_SECRET=

# --- Integrations ---------------------------------------------------------

# Encrypts the GitHub/Jira credentials entered under Settings > Integrations.
# 32 random bytes, base64: `openssl rand -base64 32`. Changing it makes stored
# credentials unreadable (reconnect each integration).
# @required @sensitive
INTEGRATIONS_ENCRYPTION_KEY=

# --- Tailscale --------------------------------------------------------------

# This machine's tailnet HTTPS URL, auto-detected from the running Tailscale
# (e.g. https://my-mac.tailnet-name.ts.net). Empty if Tailscale isn't connected.
# Development only: never detected in a container (no git, no Tailscale).
# `bun run tailnet:up` makes `tailscale serve` proxy it to the dev server.
# @type=url @required=false
TAILSCALE_URL=if(eq($APP_ENV, development), exec(`"$(git rev-parse --show-toplevel 2>/dev/null)/scripts/tailscale.sh" url 2>/dev/null || true`))

# Public base URL of the web app. Defaults to the tailnet URL, else localhost;
# in production there is no default: set it in the env file (https://<domain>).
# This must match the GitHub OAuth App's callback URL host.
# @type=url @required
BETTER_AUTH_URL=if(eq($APP_ENV, production), undefined, fallback(ref(TAILSCALE_URL), "http://localhost:3000"))

# --- GitHub OAuth -----------------------------------------------------------
# Create an OAuth App at https://github.com/settings/developers
# Callback URL: ${BETTER_AUTH_URL}/api/auth/callback/github

# @required
GITHUB_CLIENT_ID=

# @required @sensitive
GITHUB_CLIENT_SECRET=

# GitHub username(s) allowed to sign in — locks the app to these accounts.
# Comma-separated, case-insensitive. Anyone else is rejected at the OAuth
# callback; no user/session is created. Override in .env.local to change it.
# @required @example="codevachon,teammate"
AUTH_GITHUB_ALLOWED_USERS=codevachon

# --- Build info -------------------------------------------------------------
# Set by the Docker image (release workflow build args), not the env file.

# Release version of this build: the git tag without the "v" (e.g. 1.2.0).
APP_VERSION=dev

# Git commit the build was made from.
# @required=false
APP_COMMIT=
