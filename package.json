{
  "name": "daily",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:generate": "bun run --cwd packages/db db:generate",
    "db:migrate": "bun run --cwd packages/db db:migrate",
    "db:push": "bun run --cwd packages/db db:push",
    "db:studio": "bun run --cwd packages/db db:studio",
    "env:check": "varlock load",
    "tailnet:up": "scripts/tailscale.sh up",
    "tailnet:down": "scripts/tailscale.sh down",
    "tailnet:status": "scripts/tailscale.sh status",
    "dev:tailnet": "scripts/tailscale.sh up && turbo dev",
    "mcp:smoke": "bun run --cwd packages/mcp mcp:smoke",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "check": "scripts/check.sh",
    "fallow": "fallow --coverage coverage/coverage-final.json",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.1.0",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "fallow": "^3.41.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.10",
    "typescript": "^5",
    "varlock": "^1.24.0",
    "vitest": "^5.1.0"
  },
  "packageManager": "bun@1.3.9",
  "engines": {
    "node": ">=20.9.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "@next/env": "npm:@varlock/nextjs-integration@^2.0.0"
  }
}
