{
  "name": "@workspace/db",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core.ts",
    "./time": "./src/time.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "db:generate": "varlock run -- drizzle-kit generate",
    "db:migrate": "varlock run -- drizzle-kit migrate",
    "db:push": "varlock run -- drizzle-kit push",
    "db:studio": "varlock run -- drizzle-kit studio",
    "lint": "eslint --max-warnings 0",
    "typecheck": "varlock codegen && tsc --noEmit"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "better-auth": "^1.7.18",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "fractional-indexing": "^4.0.0",
    "postgres": "^4.1.0",
    "varlock": "^1.24.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/node": "^20",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10",
    "typescript": "^5"
  }
}
